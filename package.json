{
  "name": "@quickstacks/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/tools/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.6.3",
      "@effect/platform-bun": "^4.0.6",
      "@effect/platform-node": "^4.0.6",
      "@effect/vitest": "^4.0.6",
      "@types/bun": "^1.4.3",
      "@types/node": "24",
      "@vitest/coverage-v8": "^5.0.5",
      "effect": "^4.0.6",
      "typescript": "^7.0.2",
      "vitest": "^5.0.5"
    }
  },
  "scripts": {
    "dev": "bun run --cwd packages/cli dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run test:hooks && bun run --filter '*' test",
    "test:hooks": "vitest run",
    "coverage": "bun run --filter '*' coverage",
    "e2e": "bun run --filter '*' e2e",
    "check": "bun run lint && bun run typecheck && bun run test && bun run e2e",
    "clean": "bun run --filter '*' clean",
    "prepare": "bun scripts/prepare.ts",
    "install:ci": "bun install --frozen-lockfile"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
