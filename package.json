{
  "name": "@steamfield/stacks-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.6.3",
      "@effect/platform-node": "^4.0.6",
      "@effect/vitest": "^4.0.6",
      "@modelcontextprotocol/sdk": "^1.32.2",
      "@types/bun": "^1.4.3",
      "@types/node": "22",
      "@vitest/coverage-v8": "^5.0.5",
      "effect": "^4.0.6",
      "typescript": "^7.0.2",
      "smol-toml": "^1.9.1",
      "vitest": "^5.0.5",
      "yaml": "^2.9.1"
    }
  },
  "scripts": {
    "dev": "INIT_CWD=\"${INIT_CWD:-${npm_config_local_prefix:-$PWD}}\" bun run --silent --cwd packages/cli dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run test:hooks && bun run --filter '*' test",
    "test:hooks": "vitest run",
    "coverage": "bun run --filter '*' coverage",
    "e2e": "bun run --filter '*' e2e",
    "check": "bun run lint && bun run typecheck && bun run test && bun run e2e",
    "clean": "bun run --filter '*' clean",
    "prepare": "bun scripts/prepare.ts",
    "install:ci": "bun install --frozen-lockfile",
    "release": "bun scripts/release.ts",
    "release:dry-run": "bun scripts/release.ts --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
