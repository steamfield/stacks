{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": false,
  "extends": "//",
  "plugins": ["./biome-plugins/boundaries.grit"],
  "overrides": [
    {
      "includes": ["registry/stacks/mobile-expo/**"],
      "javascript": { "formatter": { "quoteStyle": "single" } }
    },
    {
      "includes": ["registry/search/**"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["registry/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off", "useMaxParams": "off" },
          "style": { "noNestedTernary": "off" }
        }
      }
    },
    {
      "includes": ["registry/**/*.css"],
      "css": { "parser": { "tailwindDirectives": true } }
    },
    {
      "includes": ["registry/**/*.svelte", "registry/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" },
          "style": { "useImportType": "off", "useConst": "off" }
        }
      }
    },
    {
      "includes": [
        "registry/stacks/astro-blog/files/**",
        "registry/stacks/nextjs/files/**",
        "registry/stacks/sveltekit/files/**",
        "registry/stacks/python-react/files/frontend/**"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
