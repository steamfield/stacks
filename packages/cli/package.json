{
  "name": "@steamfield/stacks",
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "human": "bun scripts/human.ts",
    "build": "bun scripts/build.ts",
    "build:index": "bun scripts/build-index.ts",
    "search:eval": "bun scripts/search-eval.ts",
    "decorate": "bun scripts/decorate.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.registry.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:macos": "vitest run -t '\\(macOS\\)' $(grep -rlF --include='*.test.ts' '(macOS)' tests)",
    "coverage": "vitest run --coverage",
    "e2e": "bun run pack && bun test ./e2e",
    "check": "bun run lint && bun run typecheck && bun run test && bun run e2e",
    "clean": "bun scripts/clean.ts",
    "ledger:import": "bun scripts/ledger-import.ts",
    "bench": "bun scripts/bench.ts",
    "pack": "bun run build && bun scripts/pack.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "effect": "catalog:",
    "smol-toml": "catalog:",
    "yaml": "catalog:",
    "@steamfield/stacks-format": "workspace:*"
  },
  "description": "Start projects for coding agents with starter files, a build brief and verification checks.",
  "homepage": "https://stacks.steamfield.io",
  "keywords": [
    "cli",
    "scaffolding",
    "coding-agents",
    "project-setup"
  ],
  "bin": {
    "stacks": "dist/stacks"
  },
  "files": [
    "dist/stacks",
    "dist/cli.mjs",
    "registry",
    "skills",
    "docs/authoring.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steamfield/stacks",
    "directory": "packages/cli"
  }
}
