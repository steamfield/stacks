{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bash .cursor/hooks/guard.sh",
        "matcher": "^(Shell|Write|Delete)$",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "bash .cursor/hooks/guard.sh read"
      }
    ]
  }
}
