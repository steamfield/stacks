{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git reset --hard*": "deny",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "rm -rf .": "deny"
    }
  },
  "formatter": false
}
