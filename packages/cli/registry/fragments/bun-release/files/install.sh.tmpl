#!/usr/bin/env bash
# Installs {{project_slug}} from GitHub Releases:
#
#   curl -fsSL https://github.com/{{package_scope}}/{{project_slug}}/releases/latest/download/install.sh | bash
#
# Downloads the binary for this OS and CPU, checks it against the release's SHA256SUMS, and
# installs it as ${{env_prefix}}_INSTALL_DIR/{{project_slug}} (default ~/.local/bin). Nothing is installed if the
# checksum doesn't match. Settings (env):
#   {{env_prefix}}_INSTALL_DIR    where to put {{project_slug}} (default ~/.local/bin)
#   {{env_prefix}}_VERSION        a tag like v0.2.0 (default: the latest release)
#   {{env_prefix}}_RELEASES_REPO  owner/repo (default {{package_scope}}/{{project_slug}})
#   {{env_prefix}}_RELEASES_URL   the releases base URL (default https://github.com/<repo>/releases;
#                         tests point it at a local stub)
# It downloads through GitHub's release download URLs, so it needs no API call and no JSON parsing.
set -euo pipefail

repo="${{{env_prefix}}_RELEASES_REPO:-{{package_scope}}/{{project_slug}}}"
base="${{{env_prefix}}_RELEASES_URL:-}"
dir="${{{env_prefix}}_INSTALL_DIR:-$HOME/.local/bin}"
version="${{{env_prefix}}_VERSION:-}"

fail() {
  echo "install.sh: $*" >&2
  exit 1
}

if [ -z "$base" ]; then
  case "$repo" in
    /* | */ | "") fail "no GitHub owner in '$repo'; set {{env_prefix}}_RELEASES_REPO=owner/repo" ;;
  esac
  base="https://github.com/$repo/releases"
fi

case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) fail "no {{project_slug}} build for $(uname -s); build from source (see README)" ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=x64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) fail "no {{project_slug}} build for $(uname -m)" ;;
esac
# musl's ldd exits 1 for --version, so capture its output rather than piping it (pipefail).
libc=""
if [ "$os" = linux ]; then
  ldd_out="$(ldd --version 2>&1 || true)"
  case "$ldd_out" in
    *musl* | *MUSL* | *Musl*) libc="-musl" ;;
  esac
fi
# Under Rosetta, uname says x86_64 on an Apple Silicon Mac; the native build is faster.
if [ "$os" = darwin ] && [ "$arch" = x64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = 1 ]; then
  arch=arm64
fi
asset="{{project_slug}}-$os-$arch$libc"

if [ -n "$version" ]; then
  download="$base/download/$version"
else
  download="$base/latest/download"
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
if ! curl -fsSL "$download/$asset" -o "$tmp/$asset"; then
  [ -z "$libc" ] || fail "this release has no musl (Alpine) build; use a glibc distro or build from source"
  fail "couldn't download $download/$asset"
fi
curl -fsSL "$download/SHA256SUMS" -o "$tmp/SHA256SUMS" || fail "couldn't download $download/SHA256SUMS"

expected="$(awk -v name="$asset" '{ file = $2; sub(/^\*/, "", file); if (file == name) print $1 }' "$tmp/SHA256SUMS")"
if command -v sha256sum >/dev/null 2>&1; then
  actual="$(sha256sum "$tmp/$asset" | awk '{ print $1 }')"
else
  actual="$(shasum -a 256 "$tmp/$asset" | awk '{ print $1 }')"
fi
[ -n "$expected" ] || fail "SHA256SUMS has no line for $asset"
[ "$expected" = "$actual" ] || fail "checksum mismatch for $asset (expected $expected, got $actual); nothing installed"

mkdir -p "$dir"
# Staged in the install dir and renamed over {{project_slug}} there: a rename within one filesystem is
# atomic, so a running {{project_slug}} is never overwritten mid-read and an interrupted install leaves the
# old binary. ($tmp may be on another filesystem, where mv would copy instead.)
staged="$dir/.{{project_slug}}.install.$$"
trap 'rm -rf "$tmp" "$staged"' EXIT
cp "$tmp/$asset" "$staged"
chmod 0755 "$staged"
mv -f "$staged" "$dir/{{project_slug}}"
echo "Installed {{project_slug}} to $dir/{{project_slug}}"
case ":$PATH:" in
  *":$dir:"*) ;;
  *) echo "Add $dir to your PATH, e.g.: echo 'export PATH=\"$dir:\$PATH\"' >> ~/.zshrc" ;;
esac
