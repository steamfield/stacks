import { createRoute, OpenAPIHono } from '@hono/zod-openapi';
import { ErrorResponse, MeResponse } from '{{project_slug}}-schemas';

// The Variables the auth chain sets, spelled out: client.ts reaches this module,
// so it must not import middleware/.
export const me = new OpenAPIHono<{ Variables: { userId: string | null } }>().openapi(
  createRoute({
    method: 'get',
    path: '/',
    tags: ['Auth'],
    summary: 'Current user',
    description: 'The verified caller: the authenticated half of the proving slice.',
    security: [{ bearerAuth: [] }],
    responses: {
      200: { description: 'The caller', content: { 'application/json': { schema: MeResponse } } },
      401: {
        description: 'No valid session token',
        content: { 'application/json': { schema: ErrorResponse } },
      },
    },
  }),
  (c) => {
    const id = c.get('userId');
    // requireAuth runs before every non-public route, so a missing id is a miswired chain.
    if (!id) throw new Error('userId missing behind requireAuth');
    return c.json({ id }, 200);
  },
);
