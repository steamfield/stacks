{
  "extraKnownMarketplaces": {
    "rr": {
      "source": {
        "source": "github",
        "repo": "rileyhilliard/rr"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "rr@rr": true
  },
  "permissions": {
    "allow": [
      "Bash(rr doctor)",
      "Bash(rr doctor *)",
      "Bash(rr status)",
      "Bash(rr status *)",
      "Bash(rr tasks)",
      "Bash(rr tasks *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rr-route-tests.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
