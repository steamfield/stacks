---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { PostHeader } from "../components/PostHeader";
import { ReadToggle } from "../components/ReadToggle";
import { readingTime, slugFor } from "../lib/posts";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/${slugFor(post)}`}
  image={post.data.ogImage}
  noindex={post.data.status !== "published"}
>
  <article>
    <PostHeader post={post} minutes={readingTime(post.body ?? "")} />
    {post.data.cover && <img src={post.data.cover} alt="" />}
    <div class="prose dark:prose-invert mt-8">
      <slot />
    </div>
    <ReadToggle client:visible />
  </article>
</BaseLayout>
