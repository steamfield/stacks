# Copy to .env locally. Never commit secrets.
PORT_API=3000
PORT_WEB=4321
LOG_LEVEL=info
LOG_FILE=logs/server.jsonl
MAX_BODY_BYTES=65536
NO_COLOR=
# Serve the built site from the API (apps/web/dist after bun run build; relative to the repo root).
STATIC_DIR=
# PUBLIC_ variables are baked into the site at build time; never put a secret in one.
