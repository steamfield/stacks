---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const canonical = new URL(Astro.routePattern, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-900">
    <main class="mx-auto max-w-2xl px-6 py-16"><slot /></main>
  </body>
</html>
