# The settings config/env.py reads from the process environment, with their defaults.
# Nothing loads this file automatically: export the values, or pass it to a container
# with `docker run --env-file .env`. Copy it to .env (gitignored) and never commit secrets.

# development (default) or production. Production turns DEBUG off, requires a secret key
# and switches on secure cookies, the HTTPS redirect and HSTS.
DJANGO_ENV=development
# Defaults to on in development and off in production; production refuses it on.
# DJANGO_DEBUG=1
# Required in production: a long random value.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins (scheme and host) allowed to POST the admin's forms when served behind another domain.
DJANGO_CSRF_TRUSTED_ORIGINS=
# SQLite file; relative paths are under the project root.
DJANGO_DB_PATH=var/db.sqlite3
# Defaults follow DJANGO_ENV; HSTS starts short (3600) in production. Raise it once HTTPS works.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=3600
# Set to 1 behind a proxy that terminates TLS and overwrites X-Forwarded-Proto.
DJANGO_BEHIND_TLS_PROXY=0

# DEBUG, INFO, WARNING, ERROR or CRITICAL. LOG_FORMAT is console or json
# (default: console with DEBUG on, json otherwise).
LOG_LEVEL=INFO
# LOG_FORMAT=json

# Read by make and config/gunicorn.py, not by Django.
PORT_API=8000
API_HOST=127.0.0.1
