# Export these in your shell; the server does not load .env files.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
# How long to report NOT_SERVING before closing the port on shutdown; set it
# above the load balancer's probe interval in a deployment.
DRAIN_DELAY=0s
# gRPC server reflection for grpcurl and buf curl; false on a public endpoint.
REFLECTION=true
