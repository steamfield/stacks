{
  "permissions": {
    "allow": [
      "Bash(make generate)",
      "Bash(make generate-check)",
      "Bash(make templ-fmt-check)",
      "Bash(make htmx-check)",
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make lint-fix)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make tidy-check)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make coverage)",
      "Bash(make build)",
      "Bash(make vuln)",
      "Bash(make ci)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go list *)",
      "Bash(go tool templ generate)",
      "Bash(go tool templ fmt internal)",
      "Bash(golangci-lint run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${CLAUDE_PROJECT_DIR}/.claude/hooks/templ-generate.sh\" ]; then bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/templ-generate.sh\" || printf '%s\\n' 'templ-generate.sh: hook unavailable; allowing this call.' >&2; else printf '%s\\n' 'templ-generate.sh: hook unavailable; allowing this call.' >&2; fi",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
