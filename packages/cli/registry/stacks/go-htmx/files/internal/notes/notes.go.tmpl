package notes

import (
	"context"
	"crypto/rand"
	"slices"
	"strings"
	"sync"
	"time"
	"unicode/utf8"

	apperrors "{{project_slug}}/internal/errors"
)

const (
	MaxTitle = 200
	MaxBody  = 10000
)

type Note struct {
	ID        string
	Title     string
	Body      string
	CreatedAt time.Time
}

// Input is what the form submits, before validation.
type Input struct {
	Title string
	Body  string
}

type Store interface {
	Create(context.Context, Input) (Note, error)
	// List returns every note, newest first.
	List(context.Context) ([]Note, error)
}

// Validate trims the input and returns a Validation error naming each bad field.
func Validate(input Input) (Input, error) {
	input.Title = strings.TrimSpace(input.Title)
	input.Body = strings.TrimSpace(input.Body)
	fields := map[string]string{}
	switch {
	case input.Title == "":
		fields["title"] = "Enter a title."
	case utf8.RuneCountInString(input.Title) > MaxTitle:
		fields["title"] = "Use at most 200 characters for the title."
	}
	if utf8.RuneCountInString(input.Body) > MaxBody {
		fields["body"] = "Use at most 10,000 characters for the note."
	}
	if len(fields) > 0 {
		return input, apperrors.Validation(fields)
	}
	return input, nil
}

type Memory struct {
	mu    sync.RWMutex
	notes []Note
}

func NewMemory() *Memory { return &Memory{} }

func (m *Memory) Create(ctx context.Context, input Input) (Note, error) {
	if err := ctx.Err(); err != nil {
		return Note{}, err
	}
	input, err := Validate(input)
	if err != nil {
		return Note{}, err
	}
	m.mu.Lock()
	defer m.mu.Unlock()
	note := Note{ID: rand.Text(), Title: input.Title, Body: input.Body, CreatedAt: time.Now().UTC()}
	m.notes = append(m.notes, note)
	return note, nil
}

func (m *Memory) List(ctx context.Context) ([]Note, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	m.mu.RLock()
	defer m.mu.RUnlock()
	items := slices.Clone(m.notes)
	slices.Reverse(items)
	return items, nil
}
