{
  "permissions": {
    "allow": [
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make lint-fix)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make tidy-check)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make coverage)",
      "Bash(make build)",
      "Bash(make smoke)",
      "Bash(make call)",
      "Bash(make vuln)",
      "Bash(make ci)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go list *)",
      "Bash(golangci-lint run *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-mcp.sh\" ]; then bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-mcp.sh\" || printf '%s\\n' 'guard-mcp.sh: hook unavailable; allowing this call.' >&2; else printf '%s\\n' 'guard-mcp.sh: hook unavailable; allowing this call.' >&2; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
