// connect runs s on one end of an in-memory transport and returns a client
// session on the other, closed when the test ends.
func connect(t *testing.T, s *mcp.Server) *mcp.ClientSession {
	t.Helper()
	serverEnd, clientEnd := mcp.NewInMemoryTransports()
	serverSession, err := s.Connect(t.Context(), serverEnd, nil)
	require.NoError(t, err)
	client := mcp.NewClient(&mcp.Implementation{Name: "test-client", Version: "test"}, nil)
	session, err := client.Connect(t.Context(), clientEnd, nil)
	require.NoError(t, err)
	t.Cleanup(func() {
		assert.NoError(t, session.Close())
		assert.NoError(t, serverSession.Wait())
	})
	return session
}

func newServer(t *testing.T) (*mcp.ClientSession, *bytes.Buffer) {
	t.Helper()
	var logs bytes.Buffer
	return connect(t, New(applog.New(&logs, slog.LevelDebug), "test")), &logs
}

func call(t *testing.T, session *mcp.ClientSession, name string, args any) *mcp.CallToolResult {
	t.Helper()
	res, err := session.CallTool(t.Context(), &mcp.CallToolParams{Name: name, Arguments: args})
	require.NoError(t, err, "a tool failure must be a result, not a protocol error")
	return res
}

func text(t *testing.T, res *mcp.CallToolResult) string {
	t.Helper()
	require.Len(t, res.Content, 1)
	content, ok := res.Content[0].(*mcp.TextContent)
	require.True(t, ok, "content is %T", res.Content[0])
	return content.Text
}

func TestListTools(t *testing.T) {
	session, _ := newServer(t)
	res, err := session.ListTools(t.Context(), nil)
	require.NoError(t, err)
	require.Len(t, res.Tools, 1)
	tool := res.Tools[0]
	assert.Equal(t, "convert_units", tool.Name)
	assert.Contains(t, tool.Description, "Example:")
	assert.True(t, tool.Annotations.ReadOnlyHint)

	// The schema is derived from ConvertInput: every field required, every
	// property described, nothing else accepted.
	schema, err := json.Marshal(tool.InputSchema)
	require.NoError(t, err)
	var input struct {
		Type       string                       `json:"type"`
		Required   []string                     `json:"required"`
		Properties map[string]map[string]string `json:"properties"`
		Additional *bool                        `json:"additionalProperties"`
	}
	require.NoError(t, json.Unmarshal(schema, &input))
	assert.Equal(t, "object", input.Type)
	assert.ElementsMatch(t, []string{"value", "from", "to"}, input.Required)
	assert.Equal(t, "number", input.Properties["value"]["type"])
	for name, property := range input.Properties {
		assert.NotEmpty(t, property["description"], "property %s has no description", name)
	}
	require.NotNil(t, input.Additional)
	assert.False(t, *input.Additional)
	assert.NotNil(t, tool.OutputSchema, "the output schema is derived from ConvertOutput")
}

func TestConvertUnits(t *testing.T) {
	session, logs := newServer(t)
	res := call(t, session, "convert_units", map[string]any{"value": 5, "from": "km", "to": "mi"})
	require.False(t, res.IsError, text(t, res))
	var out ConvertOutput
	structured, err := json.Marshal(res.StructuredContent)
	require.NoError(t, err)
	require.NoError(t, json.Unmarshal(structured, &out))
	assert.InDelta(t, 3.10686, out.Value, 1e-5)
	assert.Equal(t, "mi", out.Unit)
	assert.Equal(t, "5 km = 3.10686 mi", out.Text)
	assert.Contains(t, logs.String(), `"msg":"request","method":"tools/call"`)
	assert.Contains(t, logs.String(), `"tool":"convert_units","tool_error":false`)
}

func TestConvertUnitsToolErrors(t *testing.T) {
	session, logs := newServer(t)
	tests := []struct {
		name    string
		args    map[string]any
		message string
	}{
		{name: "unknown unit", args: map[string]any{"value": 1, "from": "furlong", "to": "m"}, message: `unknown unit "furlong"; use one of`},
		{name: "different kinds", args: map[string]any{"value": 1, "from": "kg", "to": "km"}, message: "cannot convert kg (mass) to km (length)"},
		// The SDK validates arguments against the derived schema before the
		// handler runs, and reports the failure as a tool error too.
		{name: "missing argument", args: map[string]any{"value": 1, "from": "m"}, message: "to"},
		{name: "wrong type", args: map[string]any{"value": "five", "from": "m", "to": "km"}, message: "value"},
		{name: "extra argument", args: map[string]any{"value": 1, "from": "m", "to": "km", "precision": 2}, message: "precision"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			res := call(t, session, "convert_units", tt.args)
			assert.True(t, res.IsError)
			assert.Contains(t, text(t, res), tt.message)
			assert.Nil(t, res.StructuredContent)
		})
	}
	assert.NotContains(t, logs.String(), "tool failed", "client faults are not logged as server faults")
}

func TestUnknownToolIsAProtocolError(t *testing.T) {
	session, _ := newServer(t)
	_, err := session.CallTool(t.Context(), &mcp.CallToolParams{Name: "nope", Arguments: map[string]any{}})
	require.Error(t, err)
	assert.Contains(t, err.Error(), "nope")
}

type empty struct{}

func TestServerFaultsStayPrivate(t *testing.T) {
	var logs bytes.Buffer
	logger := applog.New(&logs, slog.LevelDebug)
	s := mcp.NewServer(&mcp.Implementation{Name: "faults", Version: "test"}, nil)
	addTool(s, logger, &mcp.Tool{Name: "fails"}, func(context.Context, empty) (empty, error) {
		return empty{}, apperrors.Wrap(apperrors.Internal, "read the unit table", io.ErrUnexpectedEOF)
	})
	addTool(s, logger, &mcp.Tool{Name: "panics"}, func(context.Context, empty) (empty, error) {
		panic("index out of range")
	})
	session := connect(t, s)
	for _, name := range []string{"fails", "panics"} {
		t.Run(name, func(t *testing.T) {
			res := call(t, session, name, map[string]any{})
			assert.True(t, res.IsError)
			assert.Equal(t, apperrors.InternalMessage, text(t, res))
		})
	}
	assert.Contains(t, logs.String(), `"msg":"tool failed","tool":"fails","error":"read the unit table: unexpected EOF"`)
	assert.Contains(t, logs.String(), `"tool":"panics","error":"panic: index out of range`)
	// The server survived the panic and still answers.
	_, err := session.ListTools(t.Context(), nil)
	require.NoError(t, err)
}
