# Copy to .env locally; `bun run dev` and `bun run start` load it. Never commit secrets.
# Parsed by src/config.ts, which fails at startup naming any bad value.

# Port the server listens on. PORT is the fallback when PORT_API is unset (default 3000).
PORT_API=3000
# trace, debug, info (default), warn, error, fatal or silent; case doesn't matter.
LOG_LEVEL=info
# Largest request body in bytes before the 413 envelope (default 65536).
MAX_BODY_BYTES=65536
