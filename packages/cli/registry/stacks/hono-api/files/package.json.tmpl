{
  "name": "{{project_slug}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts | pino-pretty",
    "build": "bun build src/main.ts --target=node --format=esm --packages=bundle --env=disable --outdir=dist",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "rm -rf dist coverage",
    "prepare": "bun scripts/prepare.ts"
  }
}
