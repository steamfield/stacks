# Copy to .env to change the ports the root Makefile exports to both parts. A port exported in
# the shell wins over this file. .env is gitignored; never commit secrets.
#
# Only these ports cross between the parts. Each part's own settings stay in its own file:
# backend/.env (read by bun run dev and bun run start in backend/) and frontend/.env.local.

# The API listens here, and the frontend's dev and preview proxy forwards /api to it.
PORT_API=3000
# The frontend's dev and preview server.
PORT_WEB=4173
# The frontend's Playwright tests serve the build here.
PORT_E2E=4180
