# Every task for {{project_name}}. `make help` lists them.
SHELL := /bin/bash
.DEFAULT_GOAL := help
# macOS ships GNU Make 3.81, which ignores .SHELLFLAGS, so each piped recipe starts with this
# line itself. Without pipefail a failed xcodebuild piped into xcbeautify exits 0.
STRICT := set -euo pipefail;

PROJECT := {{project_slug}}.xcodeproj
SCHEME := App
DERIVED := build/DerivedData
SWIFT_SOURCES := App AppTests AppUITests
# Simulator builds never sign, so no team or certificate is needed to build and test.
XCODEBUILD := xcodebuild -project $(PROJECT) -scheme $(SCHEME) -derivedDataPath $(DERIVED) CODE_SIGNING_ALLOWED=NO
# xcbeautify shortens xcodebuild's log when it is installed; otherwise the raw log prints.
BEAUTIFY := $(if $(shell command -v xcbeautify),| xcbeautify --quiet,)
# Resolved inside each recipe, so a missing simulator fails the target that needs it.
DESTINATION = dest="$$(bash scripts/sim-destination.sh)"
# Minimum line coverage of the app target under unit tests, in percent.
COVERAGE_MIN ?= 80
# SwiftUI views are covered by the UI tests, not unit tests, so the floor leaves them out.
COVERAGE_EXCLUDE := *View.swift *Screen.swift MainApp.swift
COVERAGE_RESULT := build/unit-tests.xcresult

.PHONY: help doctor project typecheck build lint fmt fmt-check test coverage test-ui ci clean

help: ## List the targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F ':.*## ' '{printf "  %-10s %s\n", $$1, $$2}'

doctor: ## Check the toolchain and that project.yml has a deployment target
	@for tool in xcodebuild xcodegen swiftlint; do \
	  command -v $$tool >/dev/null || { echo "doctor: $$tool is not on PATH (see docs/DEVELOPMENT.md)" >&2; exit 1; }; \
	done
	@xcrun --find swift-format >/dev/null 2>&1 || { echo "doctor: xcrun can't find swift-format; select a full Xcode with xcode-select" >&2; exit 1; }
	@grep -Eq '^[[:space:]]+iOS: "[0-9]+(\.[0-9]+)*"' project.yml || { echo "doctor: set options.deploymentTarget.iOS in project.yml (Setup step 1)" >&2; exit 1; }

project: doctor ## Generate the Xcode project from project.yml (XcodeGen), install git hooks
	xcodegen generate --quiet
	@test -n "$${CI:-}" || ! test -f lefthook.yml || ! command -v lefthook >/dev/null || lefthook install

typecheck: ## Compile the app and both test targets for the simulator, warnings as errors
	@$(STRICT) $(DESTINATION); $(XCODEBUILD) -configuration Debug -destination "$$dest" build-for-testing $(BEAUTIFY)

build: ## Release build for the simulator (production settings), warnings as errors
	@$(STRICT) $(XCODEBUILD) -configuration Release -destination 'generic/platform=iOS Simulator' build $(BEAUTIFY)

lint: ## SwiftLint, warnings fail
	swiftlint lint --strict --quiet

fmt: ## Format Swift sources with swift-format
	xcrun swift-format format --in-place --recursive --parallel $(SWIFT_SOURCES)

fmt-check: ## Fail if swift-format would change any Swift source
	xcrun swift-format lint --strict --recursive --parallel $(SWIFT_SOURCES)

test: ## Unit tests (Swift Testing) on a simulator
	@$(STRICT) $(DESTINATION); $(XCODEBUILD) -destination "$$dest" test -only-testing:AppTests $(BEAUTIFY)

coverage: ## Unit tests with line coverage; fails below COVERAGE_MIN
	@rm -rf $(COVERAGE_RESULT)
	@$(STRICT) $(DESTINATION); $(XCODEBUILD) -destination "$$dest" -enableCodeCoverage YES -resultBundlePath $(COVERAGE_RESULT) test -only-testing:AppTests $(BEAUTIFY)
	@bash scripts/coverage-check.sh $(COVERAGE_RESULT) $(SCHEME).app $(COVERAGE_MIN) "$(COVERAGE_EXCLUDE)"

test-ui: ## UI tests (XCUITest) on a simulator, ending in an accessibility audit
	@$(STRICT) $(DESTINATION); $(XCODEBUILD) -destination "$$dest" test -only-testing:AppUITests $(BEAUTIFY)

ci: fmt-check lint typecheck coverage test-ui build ## Everything CI runs

clean: ## Remove build output and the generated project
	rm -rf build $(PROJECT)
