# XcodeGen spec: the source of truth for the Xcode project. `make project` generates
# {{project_slug}}.xcodeproj from it; the .xcodeproj is gitignored and never edited by hand.
name: {{project_slug}}
options:
  deploymentTarget:
    # Setup fills this with the deployment target decision; `make project` refuses an empty value.
    iOS: ""
  createIntermediateGroups: true
settings:
  base:
    SWIFT_VERSION: "6.0"
    SWIFT_STRICT_CONCURRENCY: complete
    # Xcode's app template turns these on: nonisolated async functions run on the caller's
    # actor unless marked @concurrent, and a file sees only the modules it imports.
    SWIFT_APPROACHABLE_CONCURRENCY: YES
    SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY: YES
    SWIFT_TREAT_WARNINGS_AS_ERRORS: YES
    GCC_TREAT_WARNINGS_AS_ERRORS: YES
    ENABLE_USER_SCRIPT_SANDBOXING: YES
    TARGETED_DEVICE_FAMILY: "1"
targets:
  App:
    type: application
    platform: iOS
    sources:
      - path: App/Sources
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.{{project_slug}}
        MARKETING_VERSION: "0.1"
        CURRENT_PROJECT_VERSION: "1"
        # Xcode generates the standard keys and merges App/Info.plist, which holds the app's own
        # settings as $(BUILD_SETTING) references that AppConfig reads at launch.
        GENERATE_INFOPLIST_FILE: YES
        INFOPLIST_FILE: App/Info.plist
        INFOPLIST_KEY_CFBundleDisplayName: "{{project_name}}"
        INFOPLIST_KEY_UILaunchScreen_Generation: YES
        INFOPLIST_KEY_UIApplicationSceneManifest_Generation: YES
        INFOPLIST_KEY_UISupportedInterfaceOrientations: UIInterfaceOrientationPortrait
        APP_GREETING_SUBJECT: world
      configs:
        Debug:
          APP_ENVIRONMENT: development
        Release:
          APP_ENVIRONMENT: production
  AppTests:
    type: bundle.unit-test
    platform: iOS
    sources:
      - path: AppTests
    dependencies:
      - target: App
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.{{project_slug}}.tests
        GENERATE_INFOPLIST_FILE: YES
  AppUITests:
    type: bundle.ui-testing
    platform: iOS
    sources:
      - path: AppUITests
    dependencies:
      - target: App
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.{{project_slug}}.uitests
        GENERATE_INFOPLIST_FILE: YES
schemes:
  App:
    build:
      targets:
        App: all
    test:
      config: Debug
      targets:
        - AppTests
        - AppUITests
