# {{project_name}} development commands.
#
# Adapt the recipes, but keep the target names. `stacks verify` calls install,
# fmt-check, lint, compile, coverage, docs, build, test-consumer and api-check;
# CI calls `make ci`.

JAR         := target/{{project_slug}}
JAVA_MAJOR  := $(strip $(shell cat .java-version 2>/dev/null))
MVN         := ./mvnw -B -ntp
# The main jar alone: no tests compiled or run, no coverage, docs, sources or consumer.
MAIN_JAR    := -Dmaven.test.skip=true -Djacoco.skip=true -Dmaven.javadoc.skip=true -Dmaven.source.skip=true -Dinvoker.skip=true

# The JDK is the major in .java-version. JAVA_HOME wins when set (CI's
# setup-java, a container); otherwise macOS's JDK registry, then Homebrew's
# keg-only openjdk@<major>. Never Maven's default JDK: Homebrew's maven
# depends on the newest openjdk, which is not the LTS this project targets.
ifeq ($(strip $(JAVA_HOME)),)
ifneq ($(JAVA_MAJOR),)
JAVA_HOME := $(shell /usr/libexec/java_home -v "$(JAVA_MAJOR)" 2>/dev/null || \
	{ home="$$(brew --prefix openjdk@$(JAVA_MAJOR) 2>/dev/null)/libexec/openjdk.jdk/Contents/Home"; \
	  test -d "$$home" && echo "$$home"; })
endif
endif
export JAVA_HOME
JAR_TOOL := $(if $(JAVA_HOME),$(JAVA_HOME)/bin/)jar

.DEFAULT_GOAL := help
.PHONY: help env install fmt fmt-check lint compile test coverage docs build jar-check test-consumer api-check api-baseline ci clean

help: ## List targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}'

env: ## Check the JDK, the Maven wrapper and pom.xml's versions and metadata
	@test -n "$(JAVA_MAJOR)" || { echo "No .java-version: write the JDK major to it (STACK.md Setup)." >&2; exit 1; }
	@test -n "$$JAVA_HOME" || { echo "No JDK $(JAVA_MAJOR) found: brew install openjdk@$(JAVA_MAJOR), or set JAVA_HOME." >&2; exit 1; }
	@test -x ./mvnw || { echo "No ./mvnw: run mvn -N wrapper:wrapper -Dtype=only-script once and commit mvnw, mvnw.cmd and .mvn/wrapper/." >&2; exit 1; }
	@grep -q "<java.version>$(JAVA_MAJOR)</java.version>" pom.xml || { echo "pom.xml's <java.version> must be $(JAVA_MAJOR), the major in .java-version." >&2; exit 1; }
	@! grep -nE '<[A-Za-z0-9_.-]+\.version></' pom.xml || { echo "Fill the empty pom.xml version properties above from Maven Central (STACK.md Setup)." >&2; exit 1; }
	@! grep -n 'stacks:fill' pom.xml || { echo "Write pom.xml's <description> (STACK.md Setup)." >&2; exit 1; }

install: env ## Check the toolchain and download dependencies and plugins
	$(MVN) -q dependency:go-offline
	@test -n "$$CI" || ! test -f lefthook.yml || lefthook install

fmt: env ## Format Java sources (Spotless, palantir-java-format)
	$(MVN) -q spotless:apply

fmt-check: env ## Fail if Spotless would change any Java source
	$(MVN) -q spotless:check

lint: env ## Maven Enforcer: JDK version, dependency convergence, duplicate declarations
	$(MVN) -q validate

# Not -q: under -q javac's warnings are hidden and only "warnings found and
# -Werror specified" is left.
compile: env ## Compile main and test code with Error Prone and NullAway
	$(MVN) test-compile

test: env ## Unit, property and example tests
	$(MVN) test

coverage: env ## Unit tests with the JaCoCo line-coverage floor
	$(MVN) verify -Dmaven.javadoc.skip=true -Dmaven.source.skip=true -Dinvoker.skip=true

# Not -q, for the same reason as compile: doclint's findings are warnings.
docs: env ## Javadoc for the exported API, every doclint warning an error
	$(MVN) javadoc:javadoc
	@echo "Open target/reports/apidocs/index.html"

build: env ## The jar, sources jar and Javadoc jar, then check what each holds
	$(MVN) -q package -DskipTests -Djacoco.skip=true
	@$(MAKE) --no-print-directory jar-check

jar-check: ## Check the built jars: module descriptor, exports, sources and Javadoc
	@for jar in $(JAR).jar $(JAR)-sources.jar $(JAR)-javadoc.jar; do \
	  test -s "$$jar" || { echo "Missing $$jar: run make build." >&2; exit 1; }; done
	@"$(JAR_TOOL)" --describe-module --file $(JAR).jar | tee target/module.txt
	@grep -qx 'exports app' target/module.txt || { echo "The jar's module must export app." >&2; exit 1; }
	@! grep -E '^(exports|opens) app\.internal' target/module.txt || { echo "app.internal is exported; keep it internal (module-info.java)." >&2; exit 1; }
	@"$(JAR_TOOL)" tf $(JAR).jar | grep -qx 'app/Slug.class' || { echo "app/Slug.class is missing from the jar." >&2; exit 1; }
	@! "$(JAR_TOOL)" tf $(JAR).jar | grep -E 'Test\.class$$' || { echo "Test classes are in the jar." >&2; exit 1; }
	@"$(JAR_TOOL)" tf $(JAR)-sources.jar | grep -qx 'app/Slug.java' || { echo "app/Slug.java is missing from the sources jar." >&2; exit 1; }
	@"$(JAR_TOOL)" tf $(JAR)-javadoc.jar | grep -qx 'index.html' || { echo "index.html is missing from the Javadoc jar." >&2; exit 1; }
	@echo "jars ok: $(JAR).jar, -sources.jar, -javadoc.jar"

test-consumer: env ## Build src/it/consumer against the installed jar, as a caller would
	$(MVN) verify -DskipUTs=true -Djacoco.skip=true -Dmaven.javadoc.skip=true -Dmaven.source.skip=true

api-check: env ## Fail on an incompatible change to the exported API since api/baseline.jar
	@test -f api/baseline.jar || { echo "No api/baseline.jar: run make api-baseline once at setup, then at each release (docs/releasing.md)." >&2; exit 1; }
	$(MVN) -q package $(MAIN_JAR) japicmp:cmp
	@echo "API compatible with api/baseline.jar (report: target/japicmp/)"

api-baseline: env ## Record the current API as api/baseline.jar (first setup, then a person at each release)
	$(MVN) -q package $(MAIN_JAR)
	@mkdir -p api
	cp $(JAR).jar api/baseline.jar

ci: fmt-check ## Everything CI runs (fmt-check, enforcer, every test, coverage, Javadoc, jars, consumer, API check)
	$(MVN) verify
	@$(MAKE) --no-print-directory jar-check api-check

clean: env ## Remove build output
	$(MVN) -q clean
