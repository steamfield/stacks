# Copy to .env (bun run setup does it). Never commit secrets.
# Expo reads env only from apps/mobile/, which `bun run setup` symlinks to this file.

# --- Postgres (compose.yaml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Set to the current official Postgres alpine image before db:up.
POSTGRES_IMAGE=
# Moving PORT_DB means changing DATABASE_URL's port to match.
PORT_DB=5432

# Host-side connection string (api, tests, drizzle-kit).
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- API ---
# Moving PORT_API means setting EXPO_PUBLIC_API_URL too: the app can't read PORT_API.
PORT_API=3000

# --- Mobile -> API ---
# EXPO_PUBLIC_* is inlined into the bundle at build time; per-environment values
# belong in EAS build profiles. Unset in dev: the app uses Metro's host on port 3000.
EXPO_PUBLIC_API_URL=
