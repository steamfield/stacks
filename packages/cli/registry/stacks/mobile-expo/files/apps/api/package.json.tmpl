{
  "name": "{{project_slug}}-api",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:check": "bun --env-file=../../.env run drizzle-kit check && bun --env-file=../../.env scripts/check-schema.ts"
  }
}
