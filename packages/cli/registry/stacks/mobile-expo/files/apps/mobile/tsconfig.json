{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": { "jsx": "react-jsx", "types": ["jest"], "paths": { "@/*": ["./src/*"] } },
  "include": [
    "src/**/*.ts",
