# Copy to .env locally; ConfigModule reads it at startup, and real environment
# variables win over it. Never commit secrets.
# Validated by src/config/env.ts, which fails at startup (exit 2) naming any bad
# variable.

# Port the server listens on. PORT is the fallback when PORT_API is unset (default 3000).
PORT_API=3000
# Lowest level written: verbose, debug, log (default), warn, error or fatal; case doesn't matter.
LOG_LEVEL=log
# Largest JSON request body in bytes before the 413 envelope (default 65536).
MAX_BODY_BYTES=65536
