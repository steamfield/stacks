# Copy to .env.local for local overrides. Never commit secrets.
# Port for bun run start; stacks verify serves the production build here.
PORT_WEB=3000
# Port the Playwright tests start the production server on.
PORT_E2E=3100
# Server-rendered page and document title. Nonempty; parsed by src/lib/server/config.ts.
APP_TITLE=Items
