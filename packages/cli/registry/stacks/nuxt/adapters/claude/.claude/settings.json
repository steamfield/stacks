{
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run coverage)",
      "Bash(bunx vitest run)",
      "Bash(bunx vitest run *)",
      "Bash(bunx nuxt prepare)",
      "Bash(bun run build)",
      "Bash(bun run e2e)",
      "Bash(bun run check)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -si localhost:*)",
      "Bash(curl -si http://localhost:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-nuxt-on-write.ts\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v bash >/dev/null 2>&1 && [ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-nuxt-commands.sh\" ]; then bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-nuxt-commands.sh\" || echo \"Note: stack guard could not run; allowing this call.\" >&2; else echo \"Note: stack guard unavailable; allowing this call.\" >&2; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
