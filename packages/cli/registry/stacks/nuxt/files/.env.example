# Copy to .env for local overrides. Never commit secrets.
# nuxt dev loads .env; the built server (bun run start) doesn't, so pass its settings as real
# environment variables.
# Port stacks verify serves the production build on (as PORT for bun run start).
PORT_WEB=3000
# Port the Playwright tests start the production server on.
PORT_E2E=3100
# runtimeConfig overrides, read when the server starts.
# Private, server-only: debug, info, warn or error.
NUXT_LOG_LEVEL=info
# Public, sent to the browser: never a secret.
NUXT_PUBLIC_APP_TITLE=Notes
