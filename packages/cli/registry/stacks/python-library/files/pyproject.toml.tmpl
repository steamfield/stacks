[project]
name = "{{project_slug}}"
version = "0.1"
description = "{{project_name}}: parse and format compact durations."
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
authors = [{ name = "{{author}}" }]
classifiers = [
  "Programming Language :: Python :: 3 :: Only",
  "Typing :: Typed",
]
dependencies = []

[tool.ruff]
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "C4", "UP", "ARG", "SIM", "TC", "PTH", "ERA", "PL", "RUF", "S", "T20", "A", "FBT"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["S101", "S603", "PLR2004", "ARG", "TC", "FBT"]
"scripts/*.py" = ["T20"]

[tool.mypy]
strict = true
warn_unused_ignores = true
warn_redundant_casts = true
warn_unreachable = true

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--strict-markers --strict-config --import-mode=importlib -ra"
filterwarnings = ["error"]

[tool.coverage.run]
source_pkgs = ["package_name"]
branch = true
parallel = true

[tool.coverage.report]
fail_under = 90
show_missing = true
exclude_also = ["if TYPE_CHECKING:"]
