# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# The root Makefile reads this file and exports every name in it to both parts' commands. A name
# already exported in your shell wins. Commands run inside a part don't read this file.

# Ports. The API listens on PORT_API; the frontend's dev and preview servers listen on PORT_WEB
# and forward /api to PORT_API.
PORT_API=8000
PORT_WEB=4173
# The frontend's Playwright tests serve the build on their own port.
PORT_E2E=4180

# Backend settings (backend/app/config.py reads them).
ENVIRONMENT=development
LOG_LEVEL=INFO
