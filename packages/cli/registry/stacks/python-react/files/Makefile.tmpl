# {{project_name}} development commands.
#
# A starting point: adapt the recipes to the project, but keep the target
# names. `stacks verify` calls install, lint, typecheck, test, build,
# e2e, dev-api and dev-web. CI calls the backend-* and frontend-* sub-targets
# per job; the combined targets are for local use.

PORT_API ?= 8000
PORT_WEB ?= 5173
export PORT_API PORT_WEB

.DEFAULT_GOAL := help
.PHONY: help install lint format typecheck test coverage build dev dev-api dev-web \
	backend-install backend-lint backend-format backend-typecheck backend-test backend-coverage \
	frontend-install frontend-lint frontend-format frontend-typecheck frontend-test frontend-coverage frontend-build \
	generate-api check-api e2e clean

help: ## List targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'

# Combined targets

install: backend-install frontend-install ## Install backend and frontend dependencies
	@if [ -z "$(CI)" ] && [ -f lefthook.yml ] && command -v lefthook >/dev/null 2>&1; then lefthook install; fi

lint: backend-lint frontend-lint ## Lint and format-check both halves

format: backend-format frontend-format ## Auto-format and auto-fix both halves

typecheck: backend-typecheck frontend-typecheck ## mypy strict + tsc

test: backend-test frontend-test ## Backend and frontend tests

coverage: backend-coverage frontend-coverage ## Tests with coverage thresholds enforced

build: frontend-build ## Production frontend build

dev: ## Run API and web dev servers together
	$(MAKE) -j2 dev-api dev-web

dev-api: ## API dev server with reload on PORT_API
	cd backend && uv run uvicorn app.main:app --reload --host 127.0.0.1 --port $(PORT_API)

dev-web: ## Web dev server on PORT_WEB (proxies /api to PORT_API)
	cd frontend && bun run dev --port $(PORT_WEB) --strictPort

# Backend

backend-install: ## uv sync (--locked when CI is set)
	cd backend && uv sync $(if $(CI),--locked)

backend-lint: ## ruff check + ruff format --check
	cd backend && uv run ruff check . && uv run ruff format --check .

backend-format: ## ruff format + ruff check --fix
	cd backend && uv run ruff format . && uv run ruff check --fix .

backend-typecheck: ## mypy strict
	cd backend && uv run mypy app tests scripts

backend-test: ## pytest (parallel)
	cd backend && uv run pytest -n auto

backend-coverage: ## pytest with the coverage floor
	cd backend && uv run pytest -n auto --cov --cov-report=term-missing

# Frontend

frontend-install: ## bun install (frozen lockfile when CI is set)
	cd frontend && bun install $(if $(CI),--frozen-lockfile)

frontend-lint: ## Biome lint and format check
	cd frontend && bun run lint

frontend-format: ## Biome formatting and safe fixes (bun run format)
	cd frontend && bun run format

frontend-typecheck: ## React Router typegen + tsc
	cd frontend && bun run typecheck

frontend-test: ## vitest run
	cd frontend && bun run test

frontend-coverage: ## vitest with coverage thresholds
	cd frontend && bun run test --coverage

frontend-build: ## Static SPA build into frontend/build/client
	cd frontend && bun run build

# API client

generate-api: ## Dump OpenAPI from the backend and regenerate the typed client
	cd backend && uv run python -m scripts.dump_openapi ../frontend/openapi.json
	cd frontend && bun run generate:api

check-api: ## Fail if frontend/openapi.json no longer matches the backend's spec (run generate-api)
	@tmp=$$(mktemp); trap 'rm -f "$$tmp"' EXIT; \
	(cd backend && uv run python -m scripts.dump_openapi "$$tmp") || exit 1; \
	(cd backend && uv run python -c 'import json, sys; a, b = (json.load(open(p)) for p in sys.argv[1:]); sys.exit(a != b)' "$$tmp" ../frontend/openapi.json) \
		|| { echo "frontend/openapi.json is stale: run make generate-api"; exit 1; }

e2e: ## Playwright end-to-end tests (installs the browser on first run)
	cd frontend && bunx playwright install chromium && bun run test:e2e

clean: ## Remove caches and build output
	rm -rf backend/.pytest_cache backend/.mypy_cache backend/.ruff_cache backend/htmlcov backend/.coverage*
	rm -rf frontend/build frontend/.react-router frontend/coverage frontend/playwright-report frontend/test-results
