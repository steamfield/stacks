{
  "name": "{{project_slug}}",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "pods": "bash scripts/ios.sh pods",
    "lint": "biome check .",
    "lint:native": "xcrun swift-format lint --strict --recursive modules",
    "format": "biome check --write . && xcrun swift-format format --in-place --recursive modules",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "bundle": "bun run bundle:ios && bun run bundle:android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/js/ios/main.jsbundle --assets-dest build/js/ios",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/js/android/index.android.bundle --assets-dest build/js/android",
    "ios:build": "bash scripts/ios.sh build",
    "ios:test": "bash scripts/ios.sh test",
    "check": "bun run lint && bun run lint:native && bun run typecheck && bun run test && bun run bundle && bun run ios:build && bun run ios:test",
    "audit": "bun audit",
    "clean": "rm -rf coverage build"
  }
}
