# Copy to .env.local for local overrides. Vite bakes every VITE_* value into the JavaScript it
# ships, so anyone can read them: never put a secret here. Parsed by src/config.ts.

# Base for API requests: a same-origin path (default /api) or an absolute http(s) URL.
VITE_API_URL=/api
# Browser console log level: debug, info (default), warn, error or silent.
VITE_LOG_LEVEL=info

# Ports, read from the shell: `stacks verify` serves the build on PORT_WEB, Playwright on PORT_E2E.
PORT_WEB=4173
PORT_E2E=4180
