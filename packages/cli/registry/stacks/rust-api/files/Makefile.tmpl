# {{project_name}} development commands.
#
# Adapt the recipes, but keep the target names. `stacks verify` calls install,
# fmt-check, clippy, check, test, build and serve; CI calls `make ci`.

BIN        := {{project_slug}}
TARGET_DIR := $(or $(CARGO_TARGET_DIR),target)
RELEASE    := $(TARGET_DIR)/release/$(BIN)

.DEFAULT_GOAL := help
.PHONY: help install fmt fmt-check clippy lint check test build serve audit ci clean

help: ## List targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-12s %s\n", $$1, $$2}'

install: ## Install the toolchain rust-toolchain.toml selects and fetch crates
	rustup toolchain install --no-self-update
	cargo fetch
	@test -n "$$CI" || ! test -f lefthook.yml || lefthook install

fmt: ## Format the code
	cargo fmt --all

fmt-check: ## Fail if rustfmt would change any file
	cargo fmt --all --check

clippy: ## clippy on every target with warnings denied
	cargo clippy --locked --all-targets --all-features -- -D warnings

lint: fmt-check clippy ## fmt-check and clippy

check: ## Type-check every target
	cargo check --locked --all-targets --all-features

test: ## Unit, router and binary tests (tests/binary.rs starts the server and signals it)
	cargo test --locked --all-features

build: ## Release binary in target/release/
	cargo build --locked --release

# exec replaces the shell, so SIGINT and SIGTERM reach the server directly.
serve: build ## Build, then run the release server in the foreground until SIGINT or SIGTERM
	exec $(RELEASE)

audit: ## Advisories, licenses and sources with cargo-deny (needs network)
	@command -v cargo-deny >/dev/null 2>&1 || { \
		if command -v cargo-binstall >/dev/null 2>&1; then cargo binstall --no-confirm cargo-deny; \
		else cargo install --locked cargo-deny; fi; }
	cargo deny check

ci: fmt-check clippy test build audit ## Everything CI runs

clean: ## Remove build output
	cargo clean
