# {{project_name}} development commands.
#
# Adapt the recipes, but keep the target names. `stacks verify` calls install,
# fmt-check, clippy, check, test, doc and package; CI calls `make ci`.

.DEFAULT_GOAL := help
.PHONY: help install fmt fmt-check clippy lint check test doc package audit ci clean

help: ## List targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-12s %s\n", $$1, $$2}'

install: ## Install the toolchain rust-toolchain.toml selects and fetch crates
	rustup toolchain install --no-self-update
	cargo fetch
	@test -n "$$CI" || ! test -f lefthook.yml || lefthook install

fmt: ## Format the code
	cargo fmt --all

fmt-check: ## Fail if rustfmt would change any file
	cargo fmt --all --check

clippy: ## clippy on every target, with and without features, warnings denied
	cargo clippy --locked --all-targets -- -D warnings
	cargo clippy --locked --all-targets --all-features -- -D warnings

lint: fmt-check clippy ## fmt-check and clippy

check: ## Type-check every target with no features and with all of them
	cargo check --locked --all-targets --no-default-features
	cargo check --locked --all-targets --all-features

# Plain `cargo test` runs doctests; `--all-targets` would skip them.
test: ## Unit, integration and doc tests, with no features and with all of them
	cargo test --locked --no-default-features
	cargo test --locked --all-features

doc: ## Build the API docs with every rustdoc warning denied
	RUSTDOCFLAGS="-D warnings" cargo doc --locked --no-deps --all-features

package: ## Build and compile the .crate exactly as it would publish (uploads nothing)
	@! grep -n 'stacks:fill' Cargo.toml || { echo "Fill the package metadata in Cargo.toml first." >&2; exit 1; }
	cargo package --locked --allow-dirty --list
	cargo package --locked --allow-dirty

audit: ## Advisories, licenses and sources with cargo-deny (needs network)
	@command -v cargo-deny >/dev/null 2>&1 || { \
		if command -v cargo-binstall >/dev/null 2>&1; then cargo binstall --no-confirm cargo-deny; \
		else cargo install --locked cargo-deny; fi; }
	cargo deny check

ci: fmt-check clippy test doc package audit ## Everything CI runs

clean: ## Remove build output
	cargo clean
