{
  "permissions": {
    "allow": [
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make clippy)",
      "Bash(make lint)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make smoke)",
      "Bash(make audit)",
      "Bash(make ci)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-tui.sh\" ]; then bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-tui.sh\" || printf '%s\\n' 'guard-tui.sh: hook unavailable; allowing this call.' >&2; else printf '%s\\n' 'guard-tui.sh: hook unavailable; allowing this call.' >&2; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
