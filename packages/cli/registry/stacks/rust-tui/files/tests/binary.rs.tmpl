//! Black-box tests: run the built binary the way an agent's shell or CI does,
//! with stdin from /dev/null and stdout a pipe. It must print and exit, never
//! wait for keys; the timeout turns a hang into a failure.

use std::path::Path;
use std::time::Duration;

use assert_cmd::Command;
use serde_json::Value;

const BIN: &str = env!("CARGO_BIN_EXE_{{project_slug}}");

fn env_var(key: &str) -> String {
    format!("{}_{key}", env!("CARGO_PKG_NAME"))
        .to_uppercase()
        .replace('-', "_")
}

/// The binary in `dir`, with HOME there and nothing inherited but PATH.
fn app(dir: &Path) -> Command {
    let mut cmd = Command::new(BIN);
    cmd.env_clear()
        .env("PATH", std::env::var_os("PATH").unwrap_or_default())
        .env("HOME", dir)
        .current_dir(dir)
        .timeout(Duration::from_secs(10));
    cmd
}

fn stdout_of(cmd: &mut Command) -> String {
    let out = cmd.assert().success().stderr("").get_output().clone();
    String::from_utf8_lossy(&out.stdout).into_owned()
}

#[test]
fn help_and_version_print_and_exit() {
    let dir = tempfile::tempdir().unwrap();
    assert!(stdout_of(app(dir.path()).arg("--help")).contains("Usage:"));
    let version = stdout_of(app(dir.path()).arg("--version"));
    assert!(
        version.ends_with(&format!(" {}\n", env!("CARGO_PKG_VERSION"))),
        "{version}"
    );
    let json: Value =
        serde_json::from_str(&stdout_of(app(dir.path()).args(["--version", "--json"]))).unwrap();
    assert_eq!(json["version"], env!("CARGO_PKG_VERSION"));
}

#[test]
fn without_a_terminal_the_tasks_print_as_text_or_json() {
    let dir = tempfile::tempdir().unwrap();
    let text = stdout_of(&mut app(dir.path()));
    assert!(text.contains("T-1  doing   Write the README"), "{text}");
    let no_tui = stdout_of(app(dir.path()).arg("--no-tui"));
    assert_eq!(no_tui, text);
    let json: Value = serde_json::from_str(&stdout_of(app(dir.path()).arg("--json"))).unwrap();
    assert_eq!(json["tasks"][1]["title"], "Add a second screen");
}

#[test]
fn a_tasks_file_comes_from_the_flag_or_the_environment() {
    let dir = tempfile::tempdir().unwrap();
    std::fs::write(
        dir.path().join("tasks.json"),
        r#"[{"id":"A","title":"From a file","status":"todo"}]"#,
    )
    .unwrap();
    let flag = stdout_of(app(dir.path()).args(["--tasks", "tasks.json"]));
    assert!(flag.contains("A   todo    From a file"), "{flag}");
    let from_env = stdout_of(app(dir.path()).env(env_var("tasks"), "tasks.json"));
    assert_eq!(from_env, flag);
}

#[test]
fn failures_exit_with_their_code_and_report_once_on_stderr() {
    let dir = tempfile::tempdir().unwrap();
    std::fs::write(dir.path().join("bad.json"), r#"[{"id":"A"}]"#).unwrap();
    let cases: [(&[&str], i32, &str); 4] = [
        (&["--nope"], 2, "USAGE"),
        (&["--tasks", "missing.json"], 1, "IO"),
        (&["--tasks", "bad.json"], 1, "INVALID_DATA"),
        (&["--log-file", "no/such/dir/app.log"], 3, "LOG_FILE"),
    ];
    for (args, code, error_code) in cases {
        let human = app(dir.path())
            .args(args)
            .assert()
            .code(code)
            .stdout("")
            .get_output()
            .clone();
        let text = String::from_utf8(human.stderr).unwrap();
        assert!(
            text.starts_with(&format!("error[{error_code}]: ")),
            "{args:?}: {text}"
        );
        assert_eq!(text.matches("suggestion: ").count(), 1, "{args:?}: {text}");

        let json = app(dir.path())
            .arg("--json")
            .args(args)
            .assert()
            .code(code)
            .stdout("")
            .get_output()
            .clone();
        let document: Value = serde_json::from_slice(&json.stderr).unwrap();
        assert_eq!(document["error"]["code"], error_code, "{args:?}");
    }
}

#[test]
fn logs_go_to_the_log_file_and_never_to_stdout_or_stderr() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("app.log");
    let out = stdout_of(
        app(dir.path())
            .env(env_var("log-file"), &path)
            .env("RUST_LOG", "debug"),
    );
    assert!(!out.contains("\"message\""), "{out}");
    let log = std::fs::read_to_string(&path).unwrap();
    assert!(log.contains("\"message\":\"start\""), "{log}");
    app(dir.path())
        .env("RUST_LOG", "debug,=[")
        .assert()
        .code(3)
        .stdout("");
}
