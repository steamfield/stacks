[package]
name = "{{project_slug}}"
edition.workspace = true
description = "stacks:fill One sentence on what this package does; npm shows it in search."
license = "MIT OR Apache-2.0"
# wasm-pack copies the README into pkg/ as the npm package page.
readme = "README.md"

[lib]
# cdylib is the .wasm wasm-pack turns into the npm package in pkg/; rlib lets
# native `cargo test` and wasm-bindgen-test link the crate.
crate-type = ["cdylib", "rlib"]

[profile.release]
# A smaller .wasm download: optimize for size and link the whole graph at once.
opt-level = "s"
lto = true
codegen-units = 1

[lints]
workspace = true

# One package at the root, inside a workspace, so a second crate joins without
# moving this one. `cargo add` writes [dependencies] here.
[workspace]
resolver = "3"

[workspace.package]
edition = "2024"

[workspace.lints.rust]
unsafe_code = "forbid"
unused_must_use = "deny"
missing_docs = "deny"
unreachable_pub = "deny"

[workspace.lints.clippy]
all = { level = "deny", priority = -1 }
pedantic = { level = "warn", priority = -1 }
unwrap_used = "deny"
expect_used = "deny"
panic = "deny"
todo = "deny"
dbg_macro = "deny"
print_stdout = "deny"
print_stderr = "deny"
allow_attributes = "deny"
allow_attributes_without_reason = "deny"
