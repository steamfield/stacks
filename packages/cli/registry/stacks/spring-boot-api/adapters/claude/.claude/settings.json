{
  "permissions": {
    "allow": [
      "Bash(make env)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make lint)",
      "Bash(make compile)",
      "Bash(make test)",
      "Bash(make coverage)",
      "Bash(make test-integration)",
      "Bash(make build)",
      "Bash(make ci)",
      "Bash(./mvnw -q test *)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw -q verify *)",
      "Bash(./mvnw -q spotless:apply *)",
      "Bash(./mvnw dependency:tree *)",
      "Bash(./mvnw -q dependency:tree *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-maven.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
