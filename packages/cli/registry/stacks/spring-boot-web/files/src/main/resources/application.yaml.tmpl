# Every setting an operator changes comes from the environment; docs/configuration.md lists them.
spring:
  application:
    name: {{project_slug}}
  main:
    banner-mode: off
  lifecycle:
    timeout-per-shutdown-phase: ${SHUTDOWN_TIMEOUT:10s}
  threads:
    virtual:
      enabled: true

server:
  address: ${HOST:127.0.0.1}
  port: ${PORT:8080}
  shutdown: graceful
  error:
    whitelabel:
      enabled: false
  servlet:
    session:
      cookie:
        same-site: lax
        secure: ${SESSION_COOKIE_SECURE:false}

management:
  endpoints:
    web:
      exposure:
        include: health

logging:
  structured:
    format:
      console: ecs
