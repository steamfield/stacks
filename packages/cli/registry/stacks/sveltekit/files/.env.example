# Copy to .env for local overrides. Never commit secrets.
# Vite's dev server loads .env; the built server (node build) doesn't, so pass its settings
# as real environment variables.
# Port stacks verify serves the production build on (as PORT for bun run start).
PORT_WEB=3000
# Port the Playwright tests start the production server on.
PORT_E2E=3100
# Rebuild after changing PORT_WEB or the public origin.
# APP_ORIGIN=http://localhost:3000
# Private runtime setting, validated at startup.
APP_TITLE=Items
