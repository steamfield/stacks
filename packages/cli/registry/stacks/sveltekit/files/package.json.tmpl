{
	"name": "{{project_slug}}",
	"private": true,
	"type": "module",
	"imports": { "#lib/*": "./src/lib/*" },
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"e2e": "bun scripts/e2e.ts",
		"check": "bun run lint && bun run typecheck && bun run test && bun run e2e",
		"clean": "rm -rf .svelte-kit build coverage test-results playwright-report",
		"prepare": "bun scripts/prepare.ts"
	}
}
