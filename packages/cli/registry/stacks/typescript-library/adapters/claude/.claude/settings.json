{
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run lint:package)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run test:consumer)",
      "Bash(bun run coverage)",
      "Bash(bunx vitest run)",
      "Bash(bunx vitest run *)",
      "Bash(bun run build)",
      "Bash(bun run check)",
      "Bash(bun pm pack --dry-run)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-typescript-library-commands.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
