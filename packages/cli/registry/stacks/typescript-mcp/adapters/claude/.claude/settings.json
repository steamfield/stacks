{
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run coverage)",
      "Bash(bunx vitest run)",
      "Bash(bunx vitest run *)",
      "Bash(bun run build)",
      "Bash(bun run smoke)",
      "Bash(bun run check)",
      "Bash(node_modules/.bin/mcp-inspector --cli *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-typescript-mcp-commands.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
