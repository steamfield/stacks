# Copy to .env locally; `bun run start` and `bun run inspect` load it. A host (Claude Code, an
# editor) passes these in its own server config instead. Never commit secrets.
# Parsed by src/config.ts, which exits 2 at startup naming any bad value.

# Directory read_file may read (required). Relative paths resolve against the working directory.
MCP_ROOT=.
# trace, debug, info (default), warn, error, fatal or silent; case doesn't matter. Logs go to stderr.
LOG_LEVEL=info
# Largest file read_file returns, in bytes (default 1048576).
MAX_FILE_BYTES=1048576
