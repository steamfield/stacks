{
  "name": "{{project_slug}}",
  "private": true,
  "description": "",
  "type": "module",
  "bin": { "{{project_slug}}": "dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --packages=bundle --env=disable --outfile=dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "inspect": "mcp-inspector node --env-file-if-exists=.env dist/index.js",
    "smoke": "bun scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run coverage && bun run build && bun run smoke",
    "clean": "rm -rf dist coverage",
    "prepare": "bun scripts/prepare.ts"
  }
}
