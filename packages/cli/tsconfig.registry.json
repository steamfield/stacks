{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "node"],
    "rootDirs": [
      "registry/stacks/astro-fullstack/adapters/claude",
      "registry/stacks/astro-fullstack/files",
      "registry/fragments/claude-harness/adapters/claude",
      "registry/fragments/claude-harness/files",
      "registry/fragments/openrouter-chat-cli/adapters/claude",
      "registry/stacks/hono-api/adapters/claude",
      "registry/stacks/nextjs/adapters/claude",
      "registry/stacks/react-router/adapters/claude",
      "registry/stacks/react-vite/adapters/claude",
      "registry/stacks/sveltekit/adapters/claude",
      "registry/stacks/tauri-react/adapters/claude",
      "registry/stacks/typescript-api/adapters/claude",
      "registry/stacks/typescript-api/files",
      "registry/stacks/typescript-cli/adapters/claude"
    ],
    "allowImportingTsExtensions": true
  },
  "include": ["registry/**/*.ts", "registry/**/.claude/hooks/*.ts"],
  "exclude": [
    // Workers, React Router, Vite and generated binding types belong to the fresh scaffold.
    "registry/stacks/cloudflare-react-router/files/*.ts",
    "registry/stacks/cloudflare-react-router/files/**/*.d.ts",
    "registry/stacks/cloudflare-react-router/files/app",
    "registry/stacks/cloudflare-react-router/files/workers",
    "registry/stacks/cloudflare-react-router/files/tests",
    // Astro/React and browser dependencies are checked in the fresh blog scaffold.
    "registry/stacks/astro-blog/files/*.ts",
    "registry/stacks/astro-blog/files/src",
    "registry/stacks/astro-blog/files/tests",
    // Astro/React/Vite and browser types are installed only in the fresh scaffold.
    // Keep apps/api, packages/contract, scripts and hook tests checked here.
    "registry/stacks/astro-fullstack/files/apps/web",
    // Only the Bun entry imports @effect/platform-bun (not installed in this checkout).
    "registry/stacks/typescript-cli/files/src/bin.ts",
    // React Router/React/Vite and DOM types belong to the scaffold's dependencies.
    // Keep its scripts/ and adapter hooks checked by this project.
    "registry/stacks/react-router/files/*.ts",
    "registry/stacks/react-router/files/app",
    "registry/stacks/react-router/files/tests",
    "registry/stacks/react-router/files/e2e",
    // React, Vite, MSW, zod and DOM types belong to the SPA scaffold; keep scripts and hooks checked.
    "registry/stacks/react-vite/files/*.ts",
    "registry/stacks/react-vite/files/src",
    "registry/stacks/react-vite/files/tests",
    "registry/stacks/react-vite/files/e2e",
    // Hono, zod and pino are installed only in the API scaffold; keep scripts and hooks checked.
    "registry/stacks/hono-api/files/*.ts",
    "registry/stacks/hono-api/files/src",
    "registry/stacks/hono-api/files/tests",
    // Next/React/Vitest browser dependencies belong to the scaffold; keep scripts and hooks checked.
    "registry/stacks/nextjs/files/*.ts",
    "registry/stacks/nextjs/files/next-env.d.ts",
    "registry/stacks/nextjs/files/src",
    "registry/stacks/nextjs/files/tests",
    "registry/stacks/nextjs/files/e2e",
    // SvelteKit's $app/*, ./$types and browser dependencies resolve only in the scaffold.
    // Keep prepare/e2e scripts and adapter hook tests checked here.
    "registry/stacks/sveltekit/files/*.ts",
    "registry/stacks/sveltekit/files/src",
    "registry/stacks/sveltekit/files/tests",
    "registry/stacks/sveltekit/files/e2e",
    // Expo, Hono, Drizzle and zod are installed only in the mobile scaffold.
    "registry/stacks/mobile-expo/files/apps/**",
    "registry/stacks/mobile-expo/files/packages/**",
    // These SPAs import React, browser globals and tools installed only in the scaffold.
    "registry/stacks/python-react/files/frontend/**",
    "registry/stacks/tauri-react/files/src/**",
    "registry/stacks/tauri-react/files/tests/**",
    "registry/stacks/tauri-react/files/*.config.ts"
  ]
}
