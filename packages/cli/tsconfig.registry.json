{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "node"],
    "rootDirs": [
      "registry/stacks/astro-fullstack/adapters/claude",
      "registry/stacks/astro-fullstack/files",
      "registry/fragments/claude-harness/adapters/claude",
      "registry/fragments/claude-harness/files",
      "registry/fragments/openrouter-chat-cli/adapters/claude",
      "registry/stacks/nextjs/adapters/claude",
      "registry/stacks/react-router/adapters/claude",
      "registry/stacks/sveltekit/adapters/claude",
      "registry/stacks/tauri-react/adapters/claude",
      "registry/stacks/typescript-api/adapters/claude",
      "registry/stacks/typescript-api/files",
      "registry/stacks/typescript-cli/adapters/claude"
    ],
    "allowImportingTsExtensions": true
  },
  "include": ["registry/**/*.ts", "registry/**/.claude/hooks/*.ts"],
  // These SPAs import React, browser globals and tools installed only in the scaffold.
  "exclude": [
    // Expo, Hono, Drizzle and zod are installed only in the mobile scaffold.
    "registry/stacks/mobile-expo/files/apps/**",
    "registry/stacks/mobile-expo/files/packages/**",
    "registry/stacks/python-react/files/frontend/**",
    "registry/stacks/tauri-react/files/src/**",
    "registry/stacks/tauri-react/files/tests/**",
    "registry/stacks/tauri-react/files/*.config.ts"
  ]
}
