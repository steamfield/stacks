{
  "name": "@steamfield/stacks-format",
  "version": "0.7.0",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "schemas/",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run test",
    "clean": "rm -rf dist coverage",
    "pack": "bun run build && bun scripts/pack.ts"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
