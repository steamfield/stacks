@@ -0,0 +1,12 @@
+import { defineConfig } from "orval";
+
+export default defineConfig({
+  api: {
+    input: "./openapi.json",
+    output: {
+      target: "./src/api/generated/api.ts",
+      client: "react-query",
+      override: { mutator: { path: "./src/api/client.ts", name: "apiFetch" } },
+    },
+  },
+});
