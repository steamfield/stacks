+// SPIKE 3: prints proofFingerprint for each stack named, for the default and sandbox presets.
+// `bun scripts/spike-proof.ts <stack>...`
+import { join } from "node:path";
+import { NodeServices } from "@effect/platform-node";
+import { Effect } from "effect";
+import { compose } from "../src/core/compose/compose";
+import { proofFingerprint } from "../src/core/fingerprint";
+import { Registry } from "../src/core/registry/registry";
+
+const registry = Registry.layer([
+  { origin: "bundled", path: join(import.meta.dirname, "..", "registry") },
+]);
+
+for (const stack of process.argv.slice(2))
+  for (const preset of ["default", "sandbox"] as const) {
+    const value = await Effect.runPromise(
+      compose({
+        stack,
+        with: [],
+        without: [],
+        preset,
+        agents: ["claude"],
+        always: [],
+        mode: "new",
+      }).pipe(
+        Effect.flatMap(proofFingerprint),
+        Effect.provide(registry),
+        Effect.provide(NodeServices.layer),
+      ),
+    );
+    console.log(`${stack} ${preset} ${value}`);
+  }
