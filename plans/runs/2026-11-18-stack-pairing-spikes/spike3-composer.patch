index 00000000..08f54902
--- /dev/null
+++ b/packages/cli/src/core/compose/mount.ts
@@ -0,0 +1,70 @@
+/**
+ * SPIKE 3: mounting a workspace stack's parts. A part is its stack entry with `mount` set; a
+ * fragment whose `applies_to` names exactly one part's stack id (and not the workspace) is placed
+ * on that part. Everything else stays at the root. Thrown away with the spike.
+ */
+import type { StackMeta } from "@steamfield/stacks-format";
+import { type Entry, isFragment } from "../registry/entry";
+import type { ConditionContext } from "./conditionals";
+
+type Stack = Entry & { meta: StackMeta };
+
+/** The parts as mounted entries, in the workspace's `parts` order. */
+export function mountParts(stack: Stack | null, parts: ReadonlyArray<Stack>): Entry[] {
+  return (stack?.meta.parts ?? []).flatMap((part, i) => {
+    const entry = parts[i];
+    return entry
+      ? [{ ...entry, mount: { name: part.name, role: part.role, stack: entry.id } }]
+      : [];
+  });
+}
+
+/** A fragment with `mount` set when its `applies_to` names exactly one part's stack id. */
+export function placeFragment<E extends Entry>(
+  fragment: E,
+  workspace: Entry | null,
+  parts: ReadonlyArray<Entry>,
+): E {
+  if (!parts.length || !isFragment(fragment)) return fragment;
+  const appliesTo = fragment.meta.appliesTo;
+  if (workspace && appliesTo.includes(workspace.id)) return fragment;
+  const named = parts.filter((part) => appliesTo.includes(part.id));
+  const [only] = named;
+  return named.length === 1 && only?.mount ? { ...fragment, mount: only.mount } : fragment;
+}
+
+/** `name-step` and the part directory joined with the step's own `cwd`. */
+export function mountStep<S extends { name: string; cwd?: string }>(
+  step: S,
+  mount: Entry["mount"],
+): S {
+  if (!mount) return step;
+  const cwd = step.cwd ? `${mount.name}/${step.cwd}` : mount.name;
+  return { ...step, name: `${mount.name}-${step.name}`, cwd };
+}
+
+/** The output path of a mounted entry's file. */
+export const mountPath = (path: string, mount: Entry["mount"]) =>
+  mount ? `${mount.name}/${path}` : path;
+
+/**
+ * The condition context for one entry's body. A part, and a fragment placed on one, sees its part's
+ * stack id and tags and only the fragments placed on that part: a root fragment (git-hooks,
+ * ci-github) counts as absent in a part body. The root sees the workspace and every fragment.
+ */
+export function contextFor(
+  entry: Entry,
+  root: ConditionContext,
+  placed: ReadonlyArray<Entry>,
+  parts: ReadonlyArray<Entry>,
+): ConditionContext {
+  const mount = entry.mount;
+  if (!mount) return root;
+  const part = parts.find((candidate) => candidate.mount?.name === mount.name);
+  return {
+    ...root,
+    stack: mount.stack,
+    tags: part?.meta.tags ?? [],
+    with: placed.filter((other) => other.mount?.name === mount.name).map((other) => other.id),
+  };
+}
