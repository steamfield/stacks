+// SPIKE 3: what the remote registry does with a workspace whose pinned part bundle is missing.
+// Needs SPIKE_INDEX, an unsigned `build:index --include-unproven` output with the spike entries.
+import { cpSync, existsSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { Manifest, RegistryIndex } from "@steamfield/stacks-format";
+import { Schema } from "effect";
+import { afterEach, beforeEach, expect, test } from "vitest";
+import { bundleFile } from "./fixtures/index/harness";
+import { tempDir } from "./helpers/cli";
+import { named, publish, type RemoteServer, remoteCli, remoteServer } from "./helpers/remote-index";
+
+const source = process.env.SPIKE_INDEX ?? "";
+const registry = join(import.meta.dirname, "../registry");
+let dir: ReturnType<typeof tempDir>;
+let server: RemoteServer;
+let published: string;
+let bundled: string;
+let home: string;
+let index: RegistryIndex;
+
+beforeEach(async () => {
+  dir = tempDir();
+  published = join(dir.path, "published");
+  bundled = join(dir.path, "bundled");
+  home = join(dir.path, "home");
+  cpSync(source, published, { recursive: true });
+  cpSync(registry, bundled, { recursive: true });
+  const envelope = JSON.parse(readFileSync(join(published, "v1/index.json"), "utf8"));
+  index = Schema.decodeUnknownSync(RegistryIndex)(JSON.parse(envelope.payload));
+  publish(published, { keyId: "index-test-only", payload: envelope.payload, signature: "" });
+  server = await remoteServer(published);
+});
+afterEach(async () => {
+  await server.close();
+  dir.cleanup();
+});
+
+const scaffold = async () => {
+  const target = join(dir.path, "project");
+  const result = await remoteCli(
+    ["new", "spike-python-react", target, "--preset", "lean", "--no-launch", "--json"],
+    { home, server, host: { registry: bundled } },
+  );
+  return { result, target };
+};
+
+test.runIf(source !== "")("the index pins each part's bundle digest", () => {
+  const workspace = named(index, "stack", "spike-python-react");
+  expect(Object.keys(workspace.parts ?? {}).sort()).toEqual(["python-api", "react-vite"]);
+  expect(workspace.parts?.["react-vite"]).toBe(named(index, "stack", "react-vite").digest);
+});
+
+test.runIf(source !== "")(
+  "a missing pinned part bundle composes the drifted bundled part, unnoticed",
+  async () => {
+    const css = join(bundled, "stacks/react-vite/files/src/styles.css");
+    writeFileSync(css, `/* drifted bundled copy */\n${readFileSync(css, "utf8")}`);
+    rmSync(bundleFile(published, named(index, "stack", "react-vite")));
+    const { result, target } = await scaffold();
+    console.log("STATUS", result.status, result.stderr.slice(-400));
+    console.log("REQUESTS", JSON.stringify(server.requests));
+    expect(result.status).toBe(0);
+    const manifest = Schema.decodeUnknownSync(Manifest)(
+      JSON.parse(readFileSync(join(target, ".stacks/manifest.json"), "utf8")),
+    );
+    console.log("STACK", JSON.stringify(manifest.stack), "PARTS", JSON.stringify(manifest.parts));
+    console.log(
+      "FRONTEND CSS DRIFTED",
+      readFileSync(join(target, "frontend/src/styles.css"), "utf8").startsWith("/* drifted"),
+    );
+    expect(existsSync(join(target, "frontend/package.json"))).toBe(true);
+  },
+);
+
+test.runIf(source !== "")(
+  "an index workspace with a missing pinned part: which workspace and part compose",
+  async () => {
+    const stack = join(bundled, "stacks/spike-python-react/STACK.md");
+    writeFileSync(stack, `${readFileSync(stack, "utf8")}\nBundled workspace copy.\n`);
+    const css = join(bundled, "stacks/react-vite/files/src/styles.css");
+    writeFileSync(css, `/* drifted bundled copy */\n${readFileSync(css, "utf8")}`);
+    rmSync(bundleFile(published, named(index, "stack", "react-vite")));
+    const { result, target } = await scaffold();
+    expect(result.status).toBe(0);
+    const manifest = Schema.decodeUnknownSync(Manifest)(
+      JSON.parse(readFileSync(join(target, ".stacks/manifest.json"), "utf8")),
+    );
+    console.log("MIXED REQUESTS", JSON.stringify(server.requests));
+    console.log(
+      "MIXED STACK",
+      manifest.stack?.origin,
+      "PARTS",
+      manifest.parts?.map((p) => p.stack.origin).join(","),
+    );
+    console.log(
+      "MIXED FRONTEND CSS DRIFTED",
+      readFileSync(join(target, "frontend/src/styles.css"), "utf8").startsWith("/* drifted"),
+    );
+  },
+);
